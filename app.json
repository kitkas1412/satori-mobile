{
  "expo": {
    "name": "satori-mobile",
    "slug": "satori-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/satori-icon.png",
    "scheme": "satorimobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/satori-icon.png",
        "backgroundImage": "./assets/images/satori-icon.png",
        "monochromeImage": "./assets/images/satori-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kitkas1412.satorimobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/satori-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/satori-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd00c474-0edb-45a4-8c3c-615f74f59577"
      }
    }
  }
}
